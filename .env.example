# ==============================================================================
# MARSHALL Platform Environment Configuration
# Copy this file to .env or .env.local and configure values accordingly
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# Note: Use only getAll/setAll cookies on SSR - never deprecated get/set/remove
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Authentication & JWT Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-signing-key-min-32-chars-long

# ------------------------------------------------------------------------------
# Cloudflare R2 Storage (S3-Compatible Object Storage)
# Local dev fallback can use MinIO: http://127.0.0.1:9000
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=marshall-storage
R2_PUBLIC_URL=https://pub-your-id.r2.dev
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# Redis & BullMQ Queue Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Background Processing & Media Worker
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=4
MAX_FILE_SIZE_MB=2048

# ------------------------------------------------------------------------------
# AI Provider Credentials & Configuration
# Provider-agnostic adapter supports: openai, google, anthropic
# ------------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
GOOGLE_AI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------------
# Google OAuth Integration
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# Zoom Integration & Webhooks
# ------------------------------------------------------------------------------
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_WEBHOOK_SECRET=your_zoom_webhook_secret

# ------------------------------------------------------------------------------
# Stripe Billing & Subscriptions
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_BUSINESS_MONTHLY=price_business_monthly_id

# ------------------------------------------------------------------------------
# Observability & Analytics (Sentry & PostHog)
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-key@sentry.io/project-id
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
